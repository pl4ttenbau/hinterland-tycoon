[gd_scene format=3]

[ext_resource type="Script" path="res://game/gamescripts/ui/dialogs/road_route/road_route_actions_editor.gd" id="1"]

[node name="LoadAndUnload" type="VBoxContainer"]
theme_override_constants/separation = 8
script = ExtResource("1")

[node name="ActionContext" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
text = "Select a route point on the first tab. Transfers require a physical stop."
autowrap_mode = 3

[node name="Policy" type="Label" parent="."]
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "Actions run once, in order, moving as much as stock and capacity allow. Passengers unloaded at their destination finish their trip."
autowrap_mode = 3

[node name="Actions" type="ItemList" parent="."]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 75)
layout_mode = 2
size_flags_vertical = 3

[node name="ActionKind" type="OptionButton" parent="."]
unique_name_in_owner = true
layout_mode = 2
item_count = 2
selected = 0
popup/item_0/text = "Load"
popup/item_0/id = 0
popup/item_1/text = "Unload"
popup/item_1/id = 1

[node name="Selectors" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 12

[node name="GoodsColumn" type="VBoxContainer" parent="Selectors"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Caption" type="Label" parent="Selectors/GoodsColumn"]
layout_mode = 2
text = "Goods (select one or more)"

[node name="Goods" type="ItemList" parent="Selectors/GoodsColumn"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 100)
layout_mode = 2
select_mode = 1

[node name="PassengerColumn" type="VBoxContainer" parent="Selectors"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Caption" type="Label" parent="Selectors/PassengerColumn"]
layout_mode = 2
text = "Passenger destination interchanges"

[node name="PassengerTargets" type="ItemList" parent="Selectors/PassengerColumn"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 100)
layout_mode = 2
select_mode = 1

[node name="Buttons" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="AddAction" type="Button" parent="Buttons"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"ManagementButton"
text = "Add action"

[node name="RemoveAction" type="Button" parent="Buttons"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"ManagementButton"
text = "Remove action"

[node name="MoveUp" type="Button" parent="Buttons"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"ManagementButton"
text = "Up"

[node name="MoveDown" type="Button" parent="Buttons"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"ManagementButton"
text = "Down"

[connection signal="pressed" from="Buttons/AddAction" to="." method="_add_action"]
[connection signal="pressed" from="Buttons/RemoveAction" to="." method="_remove_action"]
[connection signal="pressed" from="Buttons/MoveUp" to="." method="_move_action" binds=[-1]]
[connection signal="pressed" from="Buttons/MoveDown" to="." method="_move_action" binds=[1]]
