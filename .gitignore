doc/messtisch*
**/bin/
# Godot 4+ specific ignores
.godot/
/android/
godot_state_charts_examples/*
exports/

# Local grass generation, diagnostics and internal notes (runtime assets stay in world/).
/tools/grass/
/doc/internal/

# Other stuff from generators

*.pyc
tools/__pycache__/

# Backups the JSON writer keeps next to a saved file (tracks.json.bak-<timestamp>); git is the history.
*.bak-*

# Local test logs
/tmp/
**/insp

# Local agent instructions (machine-specific paths)
/AGENTS.md

# Temporary scripts the Godot MCP plugin writes for each snippet it runs
addons/godot_mcp/__mcp_snippet_*
