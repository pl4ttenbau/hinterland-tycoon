[node name="EditorToolsPanel" type="VBoxContainer"]
offset_right = 720.0
offset_bottom = 90.0
size_flags_horizontal = 3

[node name="Toolbar" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="CreateRoad" parent="Toolbar" instance=ExtResource("1_tool_button")]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Draw a road: click terrain to add points (the green sphere snaps to road ends) · Enter: finish · Backspace: remove last point · Esc: cancel"
text = "Create Road"
icon = ExtResource("2_road")

[node name="CreateRail" parent="Toolbar" instance=ExtResource("1_tool_button")]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Draw a rail track: click terrain to add points (the green sphere snaps to track ends) · Enter: finish · Backspace: remove last point · Esc: cancel"
text = "Create Rail"
icon = ExtResource("3_rail")

[node name="DrawSeparator" type="VSeparator" parent="Toolbar"]
layout_mode = 2

[node name="SelectObject" parent="Toolbar" instance=ExtResource("1_tool_button")]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Click a visible road or rail to inspect it in the Inspector · Esc: leave the tool"
text = "Select Object"
editor_icon = &"ToolSelect"

[node name="EditSeparator" type="VSeparator" parent="Toolbar"]
layout_mode = 2

[node name="CreateInterchange" parent="Toolbar" instance=ExtResource("1_tool_button")]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Create an interchange: select a saved road or rail, then click one of its node markers and choose a town and name · Esc: leave the tool"
text = "Create Interchange"
icon = ExtResource("4_station")

[node name="AddStop" parent="Toolbar" instance=ExtResource("1_tool_button")]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Add a stop to a nearby interchange: select a saved road or rail, then click one of its node markers · Esc: leave the tool"
text = "Add Stop"
editor_icon = &"Add"

[node name="BuildTown" parent="Toolbar" instance=ExtResource("1_tool_button")]
unique_name_in_owner = true
