[node name="FreeTool" parent="Toolbar" instance=ExtResource("1_tool_button")]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Leave the active tool (same as Esc). An unfinished draft is cancelled; finished roads and rails are kept."
