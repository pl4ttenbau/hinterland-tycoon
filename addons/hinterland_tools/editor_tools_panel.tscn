[gd_scene load_steps=2 format=3]

[sub_resource type="ButtonGroup" id="ButtonGroup_tools"]
resource_local_to_scene = true
allow_unpress = true

[node name="EditorToolsPanel" type="VBoxContainer"]
offset_right = 720.0
offset_bottom = 90.0
size_flags_horizontal = 3

[node name="Buttons" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="BuildTown" type="Button" parent="Buttons"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Select terrain-click mode for town placement."
toggle_mode = true
button_group = SubResource("ButtonGroup_tools")
text = "Build Town"

[node name="CreateRoad" type="Button" parent="Buttons"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Click: add point · Enter: finish · Backspace: remove last · Escape: cancel"
toggle_mode = true
button_group = SubResource("ButtonGroup_tools")
text = "Create Road"

[node name="CreateRail" type="Button" parent="Buttons"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Click: add point · Enter: finish · Backspace: remove last · Escape: cancel"
toggle_mode = true
button_group = SubResource("ButtonGroup_tools")
text = "Create Rail"

[node name="ToolStatus" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
text = "No tool selected · Select Create Road or Create Rail to start drawing."
autowrap_mode = 3
