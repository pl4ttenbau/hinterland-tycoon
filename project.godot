[layer_names]

3d_render/layer_1="Default"
3d_render/layer_2="Water"
3d_render/layer_3="Landscape"
3d_render/layer_4="Towns"
3d_render/layer_5="Infrs"
3d_render/layer_6="Deco"

[physics]

3d/physics_engine="Jolt Physics"
jolt_physics_3d/limits/world_boundary_shape_size=6000.0
jolt_physics_3d/simulation/areas_detect_static_bodies=true

[rendering]

renderer/rendering_method="mobile"
viewport/hdr_2d=true
anti_aliasing/quality/screen_space_aa=1
occlusion_culling/use_occlusion_culling=true
