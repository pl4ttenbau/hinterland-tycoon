; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="HinterlandTycoon"
run/main_scene="uid://s6qceyvtti6k"
config/features=PackedStringArray("4.5", "Mobile")
config/icon="res://icon.svg"

[autoload]

Loggie="*res://addons/loggie/loggie.gd"
Enums="*res://game/gamescripts/enums.gd"
GameTypes="*res://game/gamescripts/state/types.gd"
SignalBus="*res://game/gamescripts/state/signal_bus.gd"
GlobalState="*res://game/gamescripts/state/globals.gd"
TypesInitializer="*res://game/gamescripts/services/typeloaders/types_initializer.gd"
Managers="*res://game/gamescripts/state/managers.gd"
MapListLoader="*res://game/gamescripts/services/spawners/map/map_list_loader.gd"
UiState="*res://game/gamescripts/state/ui_state.gd"

[debug_draw_3d]

settings/addon_root_folder="res://addons/debug_draw_3d"

[display]

window/vsync/vsync_mode=0

[editor_plugins]

enabled=PackedStringArray("res://addons/Basic FPS Player/plugin.cfg", "res://addons/PathMesh3D/plugin.cfg", "res://addons/instant-realistic-light/plugin.cfg", "res://addons/launchpin/plugin.cfg", "res://addons/loggie/plugin.cfg", "res://addons/script-ide/plugin.cfg", "res://addons/terrain_3d/plugin.cfg", "res://addons/tnowe_extra_controls/plugin.cfg")

[filesystem]

import/blender/enabled=false

[global_group]

RailTracks=""
Towns=""
Stations=""
RoadWays=""

[input]

move_forward={
