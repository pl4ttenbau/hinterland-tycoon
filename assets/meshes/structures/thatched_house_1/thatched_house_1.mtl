# Blender 5.0.1 MTL File: 'thatched_house_1.blend'
# www.blender.org

newmtl mat_body
Ka 1.000000 1.000000 1.000000
Ks 0.500000 0.500000 0.500000
Ke 0.000000 0.000000 0.000000
Ni 1.000000
d 1.000000
illum 2
map_Kd tex_thatched_house_body_d.png
map_Ns tex_thatched_house_body_r.png
map_Bump -bm 1.000000 tex_thatched_house_body_n.png

newmtl mat_roof
Ka 1.000000 1.000000 1.000000
Ks 0.500000 0.500000 0.500000
Ke 0.000000 0.000000 0.000000
Ni 1.000000
illum 2
map_Kd tex_thatched_house_roof_d.png
map_Ns tex_thatched_house_roof_r.png
map_d tex_thatched_house_roof_d.png
map_Bump -bm 1.000000 tex_thatched_house_roof_n.png
