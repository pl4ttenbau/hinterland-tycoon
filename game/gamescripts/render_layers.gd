## 3D render layers as bitmasks, the visual counterpart to CollisionLayers.
##
## Use as `RenderLayers.NAME`. A plain class like GameConstants, not an autoload, so it works in static
## functions, tool scripts and headless tests.
##
## How Godot uses these: a VisualInstance3D (mesh, particles, decal, ...) is drawn on the layers in its
## `layers`; cameras, lights and reflection probes only see the layers in their `cull_mask`. Combine
## layers with `|` for a mask. Layer N is bit 1 << (N - 1); the names match [layer_names]
## 3d_render/layer_N in project.godot, which is what the editor shows. Keep both in step when a layer is
## added, renamed or moved.
##
## Many scenes set `layers` in the inspector, where constants cannot be referenced; code that assigns
## layers at runtime (spawned vehicles, generated grass, markers) uses these.
class_name RenderLayers extends RefCounted

#region Layers
## Layer 1, "Default": anything not sorted onto a more specific layer.
const DEFAULT: int = 1 << 0
## Layer 2, "Water": water planes.
const WATER: int = 1 << 1
## Layer 3, "Landscape": terrain meshes.
const LANDSCAPE: int = 1 << 2
## Layer 4, "Buildings": residences, industries, station buildings.
const BUILDINGS: int = 1 << 3
## Layer 5, "Infrs": tracks, roads, signals and route markers.
const INFRS: int = 1 << 4
## Layer 6, "Deco": decoration splines and props.
const DECO: int = 1 << 5
## Layer 7, "Vehicles": everything that moves, rail and road vehicles and their effects (exhaust plumes).
## Spawned vehicles are moved onto it by RailVehicle3D.of_vehicle_obj and RoadVehicleFactory, whatever
## layer their model scene was authored on.
const VEHICLES: int = 1 << 6
## Layer 8, "Foliage": grass tiles generated by TerrainGrass.
const FOLIAGE: int = 1 << 7
#endregion

#region Masks
## What static reflection probes capture (WorldReflections): everything that does not move or sway.
## Water and vehicles stay out: a captured probe would otherwise keep showing a train that has since
## driven off. Foliage was never part of the mask either.
const STATIC_CAPTURE_MASK: int = DEFAULT | LANDSCAPE | BUILDINGS | INFRS | DECO
#endregion
